# Core service
POSTGRES_DSN=postgres://email:email@localhost:55432/email_router?sslmode=disable
MASTER_KEY=local-dev-master-key
# Dedicated 32-byte AES key, base64 encoded. Prefer the file setting on hosts.
# Generate once: (umask 077; set -C; openssl rand -base64 32 > /secure/path/mailbox-credentials.key)
# MAILBOX_CREDENTIAL_KEY_FILE=/secure/path/mailbox-credentials.key
# Compose uses the direct setting; do not also set KEY_FILE.
# MAILBOX_CREDENTIAL_KEY=
# MAILBOX_CREDENTIAL_KEY_OLDS=

# Daemon/API
EMAILD_LISTEN=127.0.0.1:8787
POLL_INTERVAL_SEC=15
CATCHALL_ADMIN=false
# Initial import per folder: newest 200 messages; 0=new mail only; -1=all history.
INITIAL_SYNC_MAX_MESSAGES=200
FETCH_MAX_MESSAGES_PER_SYNC=200
# Restrict a provider pilot to INBOX instead of discovering every IMAP folder.
# SYNC_FOLDERS=INBOX

# No model needed for receive/read/search/send/reply. Enable to use AI features.
SUMMARY_ENABLED=false

# Summarizer backend (OpenAI-compatible)
OPENAI_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=llama3:latest
SUMMARY_WORKER_CONCURRENCY=4
SUMMARY_TIMEOUT_SEC=90
EMBEDDING_MODEL_NAME=
EMBEDDING_BATCH_MAX_INPUTS=96
EMBEDDING_FLUSH_INTERVAL_SEC=1800
VISION_MODEL_NAME=
# OPENAI_API_KEY=
ATTACH_SUMMARY_ENABLED=true
ATTACH_SUMMARY_MAX_FILES=3
ATTACH_SUMMARY_MAX_FILE_BYTES=8388608
VISION_PROVIDER_MODE=auto
VISION_MAX_RETRIES=2
VISION_TIMEOUT_SEC=60
VISION_MAX_IMAGE_BYTES=2097152
PDF_RENDER_TOOL=pdftoppm
OFFICE_CONVERTER_TOOL=soffice
ATTACH_REQUIRE_PDF_RENDERER=false
ATTACH_PROMPT_INSTALL_DEPS=true

# Optional attachment storage (S3-compatible); disabled until endpoint is set.
# Use deployment secrets for credentials; never commit live keys.
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_BUCKET=agent-emails
ATTACHMENT_S3_PATH_STYLE=true
ATTACHMENT_S3_PREFIX=emails
ATTACHMENT_S3_INSECURE_SKIP_VERIFY=false

# Test toggles
RUN_S3_INTEGRATION=0

# UI gateway (shared human inbox)
UIGW_LISTEN=127.0.0.1:8790
UIGW_EMAILD_URL=http://127.0.0.1:8787
UIGW_PUBLIC_BASE_URL=https://mail.your-domain.example
UIGW_ALLOWED_ORIGIN=https://mail.your-domain.example
UIGW_SESSION_COOKIE=UIGW_SESSION
UIGW_SESSION_TTL_HOURS=336
UIGW_COOKIE_SECURE=true
UIGW_LOGIN_STATE_COOKIE=UIGW_LOGIN_STATE
UIGW_EVENTS_POLL_SEC=12
UIGW_ADMIN_KEY=replace-with-long-random-admin-key
UIGW_AUTH_PROVIDER=clerk
UIGW_ENVIRONMENT=production
UIGW_LOCAL_LOGIN_ENABLED=false
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxx
CLERK_FRONTEND_API=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROVIDER=email
# Example alias token env key format used by token_ref in shared_mailboxes:
# EMAIL_ALIAS_TOKEN_BUSINESS_PRIMARY_X_AI_EXAMPLE_COM=...

# Tailscale sidecar (docker-compose.uigateway.yml)
TS_AUTHKEY=tskey-xxxxxxxxxxxxxxxx
TS_HOSTNAME=agent-emails-ui
TS_USERSPACE=true
TS_EXTRA_ARGS=
TS_ACCEPT_DNS=true

# Must match the actor secret in the paired service environment file.
ACTOR_ENVELOPE_SECRET=replace-with-long-random-agent-actor-secret
